{
  "name": "acarshub-react",
  "private": true,
  "version": "4.3.1",
  "type": "module",
  "homepage": ".",
  "scripts": {
    "dev": "vite",
    "build": "npm run generate-sprites && vite build",
    "generate-sprites": "tsx scripts/generate-colored-sprites.ts",
    "lint": "biome check .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lighthouse": "npm run build && lhci autorun",
    "lighthouse:collect": "npm run build && lhci collect",
    "lighthouse:assert": "lhci assert",
    "analyze": "npm run build && open dist/stats.html"
  },
  "dependencies": {
    "@acarshub/types": "*",
    "@tanstack/react-virtual": "3.14.22",
    "chart.js": "4.6.1",
    "chartjs-adapter-date-fns": "3.0.0",
    "chartjs-plugin-datalabels": "2.2.0",
    "date-fns": "4.4.0",
    "loglevel": "1.9.2",
    "maplibre-gl": "6.16.0",
    "react": "19.3.1",
    "react-chartjs-2": "5.3.1",
    "react-dom": "19.3.1",
    "react-map-gl": "8.1.3",
    "react-router-dom": "7.18.4",
    "socket.io-client": "4.8.4",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.5.13",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "axe-core": "4.14.0",
    "canvas": "3.2.3",
    "happy-dom": "21.0.4",
    "jsdom": "30.1.3",
    "rollup-plugin-visualizer": "7.1.1",
    "sass": "1.106.1",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
